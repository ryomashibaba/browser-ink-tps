-}
+function isFreeProjectileSlot(slot: ProjectileSlot): boolean {
+  return !slot.active && !slot.reservedForVolley;
+}
+
+// Preserve slot order and atomic volley reservation without collecting the
+// entire free pool. Unusual counts retain Array.slice's original semantics.
+function firstFreeProjectileSlots(slots: readonly ProjectileSlot[], count: number): ProjectileSlot[] {
+  if (!Number.isSafeInteger(count) || count < 0) return slots.filter(isFreeProjectileSlot).slice(0, count);
+  const result: ProjectileSlot[] = [];
+  if (count === 0) return result;
+  for (const slot of slots) {
+    if (!isFreeProjectileSlot(slot)) continue;
+    result.push(slot);
+    if (result.length === count) break;
+  }
+  return result;
+}
+
+function countFreeProjectileSlots(slots: readonly ProjectileSlot[]): number {
+  let count = 0;
+  for (const slot of slots) if (isFreeProjectileSlot(slot)) count++;
+  return count;
+}
+
+function hasFreeProjectileSlots(slots: readonly ProjectileSlot[], count: number): boolean {
+  if (!Number.isSafeInteger(count) || count <= 0) return !(countFreeProjectileSlots(slots) < count);
+  let remaining = count;
+  for (const slot of slots) if (isFreeProjectileSlot(slot) && --remaining === 0) return true;
+  return false;
+}
 
