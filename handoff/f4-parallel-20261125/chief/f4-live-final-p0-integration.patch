+      request.source !== PaintSource.Special) return request;
+  if (!Number.isFinite(request.radiusU) || !Number.isFinite(request.radiusV) ||
+      request.radiusU <= 0 || request.radiusV <= 0) return request;
+  let factor = 1, maxGrowth = 0;
+  switch (request.type) {
+    case PaintEventType.Impact: factor = 1.5; maxGrowth = .75; break;
+    case PaintEventType.MidDroplet: factor = 1.45; maxGrowth = .65; break;
+    case PaintEventType.Foot: factor = 1.2; maxGrowth = .15; break;
+    case PaintEventType.WallImpact: factor = 1.3; maxGrowth = .4; break;
+    case PaintEventType.Bomb:
+    case PaintEventType.Special: factor = 1.55; maxGrowth = 1; break;
+    default: return request;
+  }
