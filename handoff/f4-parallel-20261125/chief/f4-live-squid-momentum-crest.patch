--- /dev/null
+++ b/src/player/F4SquidMomentumCrest.test.mjs
@@ -0,0 +1,16 @@
+import {describe,it,expect} from 'vitest';
+import {f4AirborneSquidSpeed,f4WallCrestHorizontalProbe} from './F4PlayerIntent.mjs';
+describe('F4 squid momentum and physical crest geometry',()=>{
+ it('does not repeatedly apply mist to actual airborne momentum',()=>{
+  expect(f4AirborneSquidSpeed(4,8,3,0,.5)*.5).toBe(3);
+  expect(f4AirborneSquidSpeed(4,8,9,0,.5)*.5).toBe(4);
+  expect(f4AirborneSquidSpeed(4,8,0,0,.5)*.5).toBe(2);
+ });
+ it('crosses an inclined plane horizontally with the existing reach',()=>{
+  const n={x:Math.sqrt(1-.1**2),y:.1,z:0};
+  const p=f4WallCrestHorizontalProbe(n,.4,.34,.14);
+  expect(p.x).toBe(-1);expect(p.z).toBeCloseTo(0);
+  expect(.4+n.x*p.x*p.distance).toBeCloseTo(-n.x*.48);
+  expect(f4WallCrestHorizontalProbe(n,.6,.34,.14)).toBeNull();
+ });
+});
