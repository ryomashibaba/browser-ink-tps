-export function f4AirborneSquidSpeed(humanSpeed,ownSpeed,vx,vz){
-  return Math.max(humanSpeed,Math.min(ownSpeed,Math.hypot(vx,vz)));
-}
+export function f4AirborneSquidSpeed(humanSpeed,ownSpeed,vx,vz,speedScale=1){
+  // Actual velocity already includes the movement scale. Return a target
+  // before scaling because applyHorizontalTarget applies it once.
+  if(!Number.isFinite(speedScale)||speedScale<=0)return humanSpeed;
+  return Math.max(humanSpeed,Math.min(ownSpeed,Math.hypot(vx,vz)/speedScale));
+}
+
+// Geometry only: intersect the actual wall plane along a horizontal ray.
+export function f4WallCrestHorizontalProbe(normal,signedDistance,radius,extra){
+  if(!normal||![normal.x,normal.y,normal.z,signedDistance,radius,extra].every(Number.isFinite)||
+     radius<=0||extra<0)return null;
+  const horizontal=Math.hypot(normal.x,normal.z);
+  if(horizontal<1e-6||Math.abs(normal.y)>.15)return null;
+  const distance=Math.abs(signedDistance)/horizontal;
+  if(distance>radius+.20)return null;
+  const sign=signedDistance>=0?-1:1;
+  return {x:sign*normal.x/horizontal,z:sign*normal.z/horizontal,distance:distance+radius+extra};
+}
