-// F4 cache uses the same 3D envelope as fresh sight. The caller MUST
+// Try only the caller's current real hit-volume sample offsets, in order.
+// A ray is optical admission only; actual weapon collision still owns damage.
+export function chooseF4LaunchPoint(origin,body,offsets,range,blocked){
+ const valid=p=>!!p&&[p.x,p.y,p.z].every(Number.isFinite);
+ if(!valid(origin)||!valid(body)||!Array.isArray(offsets)||!Number.isFinite(range)||range<=0||typeof blocked!=='function')
+  return {point:null,offsetY:null,reason:'OUT_OF_RANGE'};
+ const seen=new Set();
+ let inRange=false;
+ for(const offsetY of offsets){
+  if(!Number.isFinite(offsetY)||seen.has(offsetY))continue;
+  seen.add(offsetY);
+  const point={x:body.x,y:body.y+offsetY,z:body.z};
+  const d=Math.hypot(point.x-origin.x,point.y-origin.y,point.z-origin.z);
+  if(!Number.isFinite(d)||d<1e-6||d>range)continue;
+  inRange=true;
+  if(!blocked(origin,point))return {point,offsetY,reason:null};
+ }
+ return {point:null,offsetY:null,reason:inRange?'COVERED':'OUT_OF_RANGE'};
+}
