+// A retained or projected goal must still suit the current physical target.
+// Never grant movement here: Recast/Rapier/KCC admission remains mandatory.
+export function f4CombatGoalFitsSpacing(plan,currentDistance,nextDistance){
+ if(!plan||!plan.band||![currentDistance,nextDistance,plan.band.near,plan.band.far].every(Number.isFinite)||
+    currentDistance<0||nextDistance<0||plan.band.near<0||plan.band.far<plan.band.near)return false;
+ const slack=.12;
+ if(plan.advance===-1)return nextDistance>=currentDistance-slack;
+ if(plan.advance===1)return nextDistance<=currentDistance+slack&&nextDistance>=Math.min(currentDistance,plan.band.near)-slack;
+ if(plan.advance===0)return nextDistance>=plan.band.near-slack&&nextDistance<=plan.band.far+slack;
+ return false;
+}
+
+export function rankCombatCandidate({distance:next,band,covered,ownInk,recovering,lateral,recentlyHit}){
  if(!finite(next)||!band||!finite(band.ideal)||!finite(lateral)||typeof covered!=="boolean")return -Infinity;
  if(recovering)return (covered?6:0)+(ownInk?2:0)+Math.min(next,band.far+3)*.2;
