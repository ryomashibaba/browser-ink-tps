+  const distance=Math.abs(signedDistance)/horizontal;
+  if(distance>radius+.20)return null;
+  const sign=signedDistance>=0?-1:1;
+  return {x:sign*normal.x/horizontal,z:sign*normal.z/horizontal,distance:distance+radius+extra};
+}
