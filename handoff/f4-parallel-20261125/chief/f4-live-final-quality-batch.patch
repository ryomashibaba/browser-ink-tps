+// Geometry only: intersect the actual wall plane along a horizontal ray.
+export function f4WallCrestHorizontalProbe(normal,signedDistance,radius,extra){
+  if(!normal||![normal.x,normal.y,normal.z,signedDistance,radius,extra].every(Number.isFinite)||
+     radius<=0||extra<0)return null;
+  const horizontal=Math.hypot(normal.x,normal.z);
