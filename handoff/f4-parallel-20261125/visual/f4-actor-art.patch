+export function createF4ActorArt(parent,colors,makeEntity){
+ const root=makeEntity("F4:ActorArt");
+ root.enabled=false;
+ const nodes=new Map();
+ const add=(parent,p)=>{
+  const e=makeEntity("F4:Art:"+p.name);
+  try{
+   parent.addChild(e);
+   e.addComponent("render",{type:p.type,material:colors[p.tint],castShadows:false,receiveShadows:false});
+   e.setLocalPosition(...p.pos);e.setLocalScale(...p.size);e.setLocalEulerAngles(...p.angle);
+   return e;
+  }catch(error){e.destroy();throw error;}
+ };
+ let weaponRoot=null,weaponId=null,disposed=false;
+ try{
+  for(const p of BODY)nodes.set(p.name,add(root,p));
+  parent.addChild(root);
+ }catch(e){root.destroy();throw e;}
+ function setWeapon(id){
+  if(disposed||!Object.prototype.hasOwnProperty.call(WEAPONS,id))return false;
+  if(id===weaponId)return true;
+  const next=makeEntity("F4:Weapon:"+id);next.enabled=false;
+  try{
+   for(const p of WEAPONS[id])add(next,p);
+   root.addChild(next);
+  }catch(e){next.destroy();throw e;}
+  weaponRoot?.destroy();weaponRoot=next;weaponId=id;next.enabled=true;
+  return true;
+ }
+ function setStride(swing){
+  if(disposed||!Number.isFinite(swing))return;
+  nodes.get("left-leg").setLocalEulerAngles(swing,0,0);
+  nodes.get("right-leg").setLocalEulerAngles(-swing,0,0);
+  nodes.get("left-boot").setLocalEulerAngles(swing*.6,0,0);
+  nodes.get("right-boot").setLocalEulerAngles(-swing*.6,0,0);
+  nodes.get("left-arm").setLocalEulerAngles(weaponId==="twin-comets"?-25:-swing*.45,0,-10);
+ }
+ return {root,setWeapon,setStride,destroy(){if(!disposed){disposed=true;root.destroy();}}};
+}
