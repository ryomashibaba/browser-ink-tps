+// Local survey routes can be 8m long; keep genuine progress through a bend
+// or enemy-ink slowdown, with a hard six-second bound. No KCC override.
+export function localPatrolProgress(trail,foot){
+ if(!foot||![foot.x,foot.y,foot.z].every(Number.isFinite)||!Array.isArray(trail)||trail.length>=96)return false;
+ // Only a new horizontal location earns progress; repeated or vertical
+ // jitter does not. Trail is scoped to this goal, never a movement command.
+ if(trail.some(p=>Math.hypot(p.x-foot.x,p.z-foot.z)<.25))return false;
+ trail.push({x:foot.x,y:foot.y,z:foot.z});
+ return true;
+}
+export function localPatrolCanContinue(tick,issued,advanced,veto=false){
+ return [tick,issued,advanced].every(Number.isSafeInteger)&&!veto&&tick>=issued&&tick>=advanced&&tick-advanced<48&&tick-issued<360;
+}
